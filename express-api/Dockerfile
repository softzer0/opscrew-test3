# Only production dependencies go into the image: development ones (TypeScript, test tools)
# stay in this stage.
RUN cd express-api && npm prune --omit=dev

FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime
WORKDIR /app
